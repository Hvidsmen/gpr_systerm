# Локальная разработка. Скопируйте в .env; секреты в Git не добавляйте.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_DB_PATH=C:/path/to/local/db.sqlite3
# Для рабочего сервера: DJANGO_DEBUG=0, новый DJANGO_SECRET_KEY,
# конкретные DJANGO_ALLOWED_HOSTS и DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain

# LDAP / Active Directory (enable after installing requirements).
LDAP_ENABLED=false
LDAP_SERVERS=192.168.70.12,192.168.70.13
LDAP_PORT=389
LDAP_DOMAIN=yamalgazprom.local
LDAP_BIND_USER=portal-ldap@yamalgazprom.local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=OU=Yamaldorstroy,DC=yamalgazprom,DC=local
LDAP_TIMEOUT=5
