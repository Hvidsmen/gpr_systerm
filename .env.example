# Локальная разработка. Скопируйте в .env; секреты в Git не добавляйте.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_DB_PATH=C:/path/to/local/db.sqlite3
# Для рабочего сервера: DJANGO_DEBUG=0, новый DJANGO_SECRET_KEY,
# конкретные DJANGO_ALLOWED_HOSTS и DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain

# LDAP / Active Directory (enable after installing requirements).
LDAP_ENABLED=false
LDAP_SERVERS=192.168.70.12,192.168.70.13
LDAP_PORT=389
LDAP_DOMAIN=yamalgazprom.local
LDAP_BIND_USER=portal-ldap@yamalgazprom.local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=OU=Yamaldorstroy,DC=yamalgazprom,DC=local
LDAP_TIMEOUT=5

# Optional: read-only GitHub token for automatic updates of a private repository.
# Keep blank for a public repository. Used only by the Windows background updater.
GPR_UPDATE_TOKEN=

# Invitations: alternatively configure SMTP in Administration -> Outgoing mail.
PORTAL_PUBLIC_URL=http://192.168.70.9:8001/
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=site@yamaldorstroy.ru
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=site@yamaldorstroy.ru
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
